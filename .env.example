# API Configuration for Personal Multi-Agent Assistant
# At least one provider API key is required.

# Google Gemini (Default recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection:
# e.g., gemini/gemini-2.5-flash, gemini/gemini-2.5-pro, gpt-4o, claude-3-5-sonnet-20241022
DEFAULT_MODEL=gemini/gemini-2.5-flash

# Self-Correction Maximum Retry Limit
MAX_EVAL_RETRIES=3

# Safe Execution Sandbox Directory
SANDBOX_DIR=./sandbox
