# API Configuration for Personal Multi-Agent Assistant
# At least one provider API key is required.

# Google Gemini (Default recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection:
DEFAULT_MODEL=gemini/gemini-3.5-flash

# Telegram Bot Integration (Optional for 24/7 Mobile Chat)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Self-Correction Maximum Retry Limit
MAX_EVAL_RETRIES=3

# Safe Execution Sandbox Directory
SANDBOX_DIR=./sandbox

